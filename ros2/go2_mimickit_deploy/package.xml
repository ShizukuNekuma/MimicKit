<?xml version="1.0"?>
<package format="3">
  <name>go2_mimickit_deploy</name>
  <version>0.1.0</version>
  <description>ROS2 low-level deployment node for MimicKit GO2 pace policies.</description>
  <maintainer email="mimickit@localhost">MimicKit Developers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>unitree_go</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
